# Multi-stage C++ Drogon build using Ubuntu Noble pre-built package
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libdrogon-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Build application
WORKDIR /app
COPY backend/ /app/
RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# Minimal Runtime image
FROM ubuntu:24.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    libdrogon1t64 \
    libsqlite3-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/build/molexplorer_backend /app/molexplorer_backend
COPY backend/config.json /app/config.json
RUN mkdir -p /app/uploads

EXPOSE 8080
CMD ["/app/molexplorer_backend"]
